# Copy this file to .env and set the spreadsheet ID from its Google Sheets URL.
export VICTUS_GOOGLE_SHEETS_ID=""

# Optional overrides. By default both files live under data/google/.
# export VICTUS_GOOGLE_OAUTH_CLIENT_FILE="/absolute/path/to/client.google-oauth.json"
# export VICTUS_GOOGLE_OAUTH_TOKEN_FILE="/absolute/path/to/google-sheets-token.json"
